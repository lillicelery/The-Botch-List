{
  "name": "the-botch-list",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently --names \"api,vite\" --prefix-colors \"cyan,green\" \"node --watch server/index.mjs\" \"vite\"",
    "server:dev": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "apify:maps": "node --env-file=.env scripts/apify/run.mjs",
    "apify:map": "node scripts/apify/map-to-providers.mjs",
    "yelp:fetch": "node --env-file=.env scripts/yelp/run.mjs",
    "yelp:map": "node scripts/yelp/map-to-providers.mjs",
    "reddit:fetch": "node --env-file=.env scripts/reddit/fetch.mjs",
    "reddit:map": "node scripts/reddit/map-to-providers.mjs",
    "data:prune-cosmetic-snippets": "node scripts/prune-non-cosmetic-snippets.mjs",
    "data:deduplicate": "node scripts/common/deduplicate.mjs",
    "sqlite:import": "node scripts/sqlite/import-providers.mjs",
    "sqlite:import:apify": "node scripts/sqlite/import-apify-providers.mjs",
    "sqlite:migrate:fts": "node scripts/sqlite/migrate-add-fts.mjs",
    "sqlite:migrate:workplace-slug": "node scripts/sqlite/migrate-add-workplace-slug.mjs",
    "sqlite:migrate:provider-type": "node scripts/sqlite/migrate-add-provider-type.mjs",
    "sqlite:populate:workplace-slug": "node scripts/sqlite/populate-workplace-slug.mjs",
    "sqlite:query:providers": "node scripts/sqlite/query-providers.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@paper-design/shaders-react": "^0.0.76",
    "apify-client": "^2.22.3",
    "better-sqlite3": "^12.9.0",
    "framer-motion": "^12.38.0",
    "hono": "^4.12.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.3"
  }
}
