# Copy to .env and fill in. Never commit .env.
APIFY_TOKEN=your_apify_api_token_here

# Optional - Google Maps actor (compass/crawler-google-places)
# Cosmetic-only defaults
# MAPS_LOCATION_QUERY=Seattle, WA, USA
# MAPS_SEARCH=plastic surgeon
# MAPS_MAX_PLACES=10
# MAPS_MAX_REVIEWS=3
# MAPS_REVIEWS_SORT=newest
# MAPS_REVIEWS_ORIGIN=google
# MAPS_REVIEWS_START_DATE=3 months
# MAPS_REVIEWS_FILTER_STRING=rhinoplasty

# Yelp Fusion API — register at https://www.yelp.com/developers
YELP_API_KEY=your_yelp_fusion_api_key_here

# Reddit API — register a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# Optional Reddit mapping (local curated exports)
# Place reddit-*.json files in scripts/reddit/output then run: npm run reddit:map
